#!/bin/bash
# Exit 0 if the lid is closed, 1 if open or unknown.
# The PAM gate before pam_fprintd runs this (see fingerprint-pam). With
# the lid closed the fingerprint reader is unreachable and pam_fprintd would
# block for 30 seconds.
# Reads /proc/acpi. loginctl only reports lid events it acted on.
# Unknown state counts as open, thus fingerprint auth still runs.
# From Omarchy's omarchy-hw-laptop-closed (MIT).

set -uo pipefail

for state in /proc/acpi/button/lid/*/state; do
    [[ -r $state ]] || continue
    [[ $(<"$state") == *closed* ]] && exit 0
done

exit 1
